<div class="row"> {% if site.enable_publication_thumbnails %} <div class="col col-sm-2 abbr"> {% if entry.abbr %} {% if site.data.venues[entry.abbr] %} {% assign venue_style = null %} {% if site.data.venues[entry.abbr].color != blank %} {% assign venue_style = site.data.venues[entry.abbr].color | prepend: 'style="background-color:' | append: '"' %} {% endif %}
      <abbr
        class="badge rounded w-100"
        {% if venue_style %}{{ venue_style }}{% endif %}
      >
        {% if site.data.venues[entry.abbr].url %}
          <a href="{{ site.data.venues[entry.abbr].url }}">{{ entry.abbr }}</a>
        {% else %}
          <div>{{ entry.abbr }}</div>
        {% endif %}
      </abbr>
    {% else %}
      <abbr class="badge rounded w-100">{{ entry.abbr }}</abbr>
    {% endif %}
  {% endif %}

  {% if entry.preview %}
    {% if entry.preview contains '://' %}
      <img class="preview z-depth-1 rounded" src="{{ entry.preview }}">
    {% else %}
      {% assign entry_path = entry.preview | prepend: '/assets/img/publication_preview/' %}
      {%
        include figure.liquid
        loading="eager"
        path=entry_path
        sizes="200px"
        class="preview z-depth-1 rounded"
        zoomable=true
        avoid_scaling=true
        alt=entry.preview
      %}
    {% endif %}
  {% endif %}
</div>


{% endif %}

<div id="{{ entry.key }}" class="{% if site.enable_publication_thumbnails %}col-sm-9{% else %}col-sm-12{% endif %}" >
<div class="publication-citation">

  <!-- ==================== CITATION TEXT ==================== -->

  <div class="publication-citation-text">

<!-- AUTHORS -->

<span class="publication-authors">{% assign author_array_size = entry.author_array | size %}{% assign author_array_limit = author_array_size %}{% if site.max_author_limit and author_array_size > site.max_author_limit %}{% assign author_array_limit = site.max_author_limit %}{% endif %}{% for author in entry.author_array limit: author_array_limit %}{% assign author_is_self = false %}{% assign author_last_name = author.last | regex_replace: '[∗†‡§¶‖&^]', '' %}{% assign author_last_html = author.last | regex_replace: '([∗†‡§¶‖&^]+)', '<sup>\1</sup>' %}{% if site.scholar.last_name contains author_last_name and site.scholar.first_name contains author.first %}{% assign author_is_self = true %}{% endif %}{% assign coauthor_url = null %}{% assign clean_last_name = author_last_name | downcase | remove_accents %}{% if site.data.coauthors[clean_last_name] %}{% for coauthor in site.data.coauthors[clean_last_name] %}{% if coauthor.firstname contains author.first %}{% assign coauthor_url = coauthor.url %}{% break %}{% endif %}{% endfor %}{% endif %}{% unless forloop.first %}{% if forloop.last %} & {% else %}, {% endif %}{% endunless %}{% if forloop.first %}{% if author_is_self %}<em>{{ author_last_html }}, {{ author.first }}</em>{% elsif coauthor_url %}<a href="{{ coauthor_url }}">{{ author_last_html }}, {{ author.first }}</a>{% else %}{{ author_last_html }}, {{ author.first }}{% endif %}{% else %}{% if coauthor_url %}<a href="{{ coauthor_url }}">{{ author.first }} {{ author_last_html }}</a>{% else %}{{ author.first }} {{ author_last_html }}{% endif %}{% endif %}{% endfor %}{% assign more_authors = author_array_size | minus: author_array_limit %}{% if more_authors > 0 %}, and {{ more_authors }} more author{% if more_authors > 1 %}s{% endif %}{% endif %}</span>.

    <!-- YEAR -->
    {% if entry.year %}
      <span class="publication-year">{{ entry.year }}</span>.
    {% endif %}

    <!-- TITLE -->
    <span class="publication-title">{{ entry.title }}</span>.

    <!-- VENUE -->
    {% assign proceedings = 'inproceedings,incollection' | split: ',' %}
    {% assign thesis = 'thesis,mastersthesis,phdthesis' | split: ',' %}

    {% if entry.type == 'article' %}
      {% if entry.journal %}
        <span class="publication-venue"><em>{{ entry.journal }}</em></span>.
      {% endif %}

    {% elsif proceedings contains entry.type %}
      {% if entry.booktitle %}
        <span class="publication-venue"><em>{{ entry.booktitle }}</em></span>.
      {% endif %}

    {% elsif thesis contains entry.type %}
      {% if entry.school %}
        <span class="publication-venue"><em>{{ entry.school }}</em></span>.
      {% endif %}

    {% elsif entry.type == 'book' or entry.type == 'inbook' %}
      {% if entry.publisher %}
        <span class="publication-venue"><em>{{ entry.publisher }}</em></span>.
      {% endif %}

    {% else %}
      {% if entry.journal %}
        <span class="publication-venue"><em>{{ entry.journal }}</em></span>.
      {% elsif entry.booktitle %}
        <span class="publication-venue"><em>{{ entry.booktitle }}</em></span>.
      {% elsif entry.school %}
        <span class="publication-venue"><em>{{ entry.school }}</em></span>.
      {% elsif entry.publisher %}
        <span class="publication-venue"><em>{{ entry.publisher }}</em></span>.
      {% endif %}
    {% endif %}

    <!-- LOCATION -->
    {% if entry.location %}
      <span class="publication-location">{{ entry.location }}.</span>
    {% endif %}

    <!-- NOTE -->
    {% if entry.note %}
      <span class="publication-note">{{ entry.note | strip }}.</span>
    {% endif %}

    <!-- ADDITIONAL INFO -->
    {% if entry.additional_info %}
      <span class="publication-additional-info">
        {{ entry.additional_info | markdownify | remove: '<p>' | remove: '</p>' | strip }}.
      </span>
    {% endif %}

  </div>


  <!-- ==================== LINKS ==================== -->

  <span class="links">

    {% if entry.award %}
      <a class="award btn btn-sm z-depth-0" role="button">
        {% if entry.award_name %}
          {{ entry.award_name }}
        {% else %}
          Awarded
        {% endif %}
      </a>

    {% elsif entry.abstract %}
      <a class="abstract btn btn-sm z-depth-0" role="button">Abs</a>

    {% elsif entry.pdf %}
      {% if entry.pdf contains '://' %}
        <a href="{{ entry.pdf }}" class="btn btn-sm z-depth-0" role="button">Paper</a>
      {% else %}
        <a
          href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}"
          class="btn btn-sm z-depth-0"
          role="button"
        >Paper</a>
      {% endif %}

    {% elsif entry.handout %}
      {% if entry.handout contains '://' %}
        <a href="{{ entry.handout }}" class="btn btn-sm z-depth-0" role="button">Handout</a>
      {% else %}
        <a
          href="{{ entry.handout | prepend: '/assets/pdf/' | relative_url }}"
          class="btn btn-sm z-depth-0"
          role="button"
        >Handout</a>
      {% endif %}

    {% elsif entry.slides %}
      {% if entry.slides contains '://' %}
        <a href="{{ entry.slides }}" class="btn btn-sm z-depth-0" role="button">Slides</a>
      {% else %}
        <a
          href="{{ entry.slides | prepend: '/assets/pdf/' | relative_url }}"
          class="btn btn-sm z-depth-0"
          role="button"
        >Slides</a>
      {% endif %}

    {% elsif entry.draft %}
      {% if entry.draft contains '://' %}
        <a href="{{ entry.draft }}" class="btn btn-sm z-depth-0" role="button">Draft</a>
      {% else %}
        <a
          href="{{ entry.draft | prepend: '/assets/pdf/' | relative_url }}"
          class="btn btn-sm z-depth-0"
          role="button"
        >Draft</a>
      {% endif %}

    {% elsif entry.doi %}
      <a
        href="https://doi.org/{{ entry.doi }}"
        class="btn btn-sm z-depth-0"
        role="button"
      >DOI</a>

    {% elsif entry.code %}
      <a
        href="{{ entry.code }}"
        class="btn btn-sm z-depth-0"
        role="button"
      >Code</a>

    {% elsif entry.html %}
      {% if entry.html contains '://' %}
        <a href="{{ entry.html }}" class="btn btn-sm z-depth-0" role="button">HTML</a>
      {% else %}
        <a
          href="{{ entry.html | prepend: '/assets/html/' | relative_url }}"
          class="btn btn-sm z-depth-0"
          role="button"
        >HTML</a>
      {% endif %}

    {% elsif entry.poster %}
      {% if entry.poster contains '://' %}
        <a href="{{ entry.poster }}" class="btn btn-sm z-depth-0" role="button">Poster</a>
      {% else %}
        <a
          href="{{ entry.poster | prepend: '/assets/pdf/' | relative_url }}"
          class="btn btn-sm z-depth-0"
          role="button"
        >Poster</a>
      {% endif %}

    {% elsif entry.video %}
      {% if site.enable_video_embedding %}
        <a class="abstract btn btn-sm z-depth-0" role="button">Video</a>
      {% else %}
        <a href="{{ entry.video }}" class="btn btn-sm z-depth-0" role="button">Video</a>
      {% endif %}

    {% elsif entry.blog %}
      <a href="{{ entry.blog }}" class="btn btn-sm z-depth-0" role="button">Blog</a>

    {% elsif entry.website %}
      <a href="{{ entry.website }}" class="btn btn-sm z-depth-0" role="button">Website</a>
    {% endif %}

  </span>

</div>


<!-- Hidden Award -->
{% if entry.award %}
  <div class="award hidden d-print-inline">
    <p>{{ entry.award | markdownify }}</p>
  </div>
{% endif %}

<!-- Hidden Abstract -->
{% if entry.abstract %}
  <div class="abstract hidden">
    <p>{{ entry.abstract }}</p>
  </div>
{% endif %}

<!-- Hidden BibTeX -->
{% if entry.bibtex_show %}
  <div class="bibtex hidden">
    {% highlight bibtex %}
    {{- entry.bibtex | hideCustomBibtex -}}
    {% endhighlight %}
  </div>
{% endif %}

<!-- Hidden Video -->
{% if entry.video and site.enable_video_embedding %}
  <div class="abstract hidden">
    <div style="text-align: center;">
      {% include video.liquid path=entry.video class="img-fluid rounded z-depth-1" controls=true %}
    </div>
  </div>
{% endif %}

</div> </div>
